---
import { links } from '../const'
import LinkButton from './LinkButton.astro'
---

<div class="sm:flex space-y-4 sm:space-x-4">
  <div class="flex sm:flex-col text-center">
    <LinkButton
      href={links.shopBookCollection}
      variant="filled"
      extraClass="w-[200px]"
    >
      Buy EPUB or PDF
    </LinkButton>
    <span class="m-2 text-sm"
      >(<span class="line-through text-gray-500">$30</span> $15)
    </span>
  </div>
  <div class="flex sm:flex-col text-center">
    <LinkButton
      href={links.amazonBookKindle}
      variant="outlined"
      extraClass="w-[200px]"
    >
      Buy on Kindle
    </LinkButton>
    <span class="m-2 text-sm">($30)</span>
  </div>
</div>
